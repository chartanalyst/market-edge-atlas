# Supabase (required — from Lovable Cloud or Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only — Settings → API → service_role / sb_secret
SUPABASE_SERVICE_ROLE_KEY=

# Client bundle (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Admin bootstrap — only this email gets first-admin on sign-in
BOOTSTRAP_ADMIN_EMAIL=chartanalyst1000@gmail.com

# Contact form
CONTACT_TO=client-inbox@email.com

# Email delivery (SMTP — checked first when configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Market Edge Atlas"

# Or Web3Forms: https://web3forms.com
WEB3FORMS_ACCESS_KEY=
# RESEND_API_KEY=
# RESEND_FROM="Market Edge Atlas <onboarding@resend.dev>"
# Legacy Gmail aliases (optional): GMAIL_USER / GMAIL_APP_PASSWORD

# Optional — apply migration via Management API
# SUPABASE_ACCESS_TOKEN=sbp_...
